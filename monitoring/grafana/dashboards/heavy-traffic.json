   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{application=\"coupon-api\",uri=~\"/api.*\",status=~\"5..\"}[30s])) / sum(rate(http_server_requests_seconds_count{application=\"coupon-api\",uri=~\"/api.*\"}[30s]))",
